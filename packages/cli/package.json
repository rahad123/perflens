{
  "name": "@perflens/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Performance Audit CLI",
  "bin": {
    "perflens": "bin/perflens.cjs"
  },
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
