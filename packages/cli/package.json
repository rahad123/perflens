  },
  "dependencies": {
    "@perflens/analysis-engine": "workspace:*",
    "@perflens/reporting": "workspace:*",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  }
}
