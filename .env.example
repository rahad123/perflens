# Local-only credentials. Replace these before use outside an isolated workstation.
POSTGRES_USER=perflens
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=perflens
API_PORT=3002
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
DEPLOYMENT_ENVIRONMENT=local
OTEL_SERVICE_NAME=perflens-demo-api
POSTGRES_IMAGE=postgres:18.6
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.161.0
TEMPO_IMAGE=grafana/tempo:2.10.8
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
GRAFANA_IMAGE=grafana/grafana:13.2.2
